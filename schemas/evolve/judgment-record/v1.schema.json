{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-catapult:evolve:judgment-record:v1",
  "title": "evolve judgment record v1",
  "description": "The master §5.4 judgment provenance record for one judged candidate overlay: judgment_id, run_id, candidate_overlay_sha256, skill_under_test, task_set_id, task_set_version, judge_model, rubric_sha256, per_criterion_scores, weighted_aggregate, verdict, cost_usd, recorded_at, recorder. Judgment records live write-once under evolve/raw/<run-id>/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "judgment_id",
    "run_id",
    "candidate_overlay_sha256",
    "skill_under_test",
    "task_set_id",
    "task_set_version",
    "judge_model",
    "rubric_sha256",
    "per_criterion_scores",
    "weighted_aggregate",
    "verdict",
    "cost_usd",
    "recorded_at",
    "recorder"
  ],
  "properties": {
    "judgment_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "candidate_overlay_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "skill_under_test": { "type": "string", "minLength": 1 },
    "task_set_id": { "type": "string", "minLength": 1 },
    "task_set_version": { "type": "integer", "minimum": 1 },
    "judge_model": { "type": "string", "minLength": 1 },
    "rubric_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "per_criterion_scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "score"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "weighted_aggregate": { "type": "number", "minimum": 0, "maximum": 1 },
    "verdict": { "type": "string", "enum": ["Accepted", "Rejected"] },
    "cost_usd": { "type": "number", "minimum": 0 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "recorder": { "type": "string", "minLength": 1 }
  }
}
